# ============================================================
# COARE AUTONOMOUS SUITE — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------------------------------------------------
# AI ENGINE — External AI Integration (Optional)
# ----------------------------------------------------------

# OpenAI GPT-4 for advanced AI analysis
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude for ethical AI reasoning
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Local Ollama (free, private, no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ----------------------------------------------------------
# NOTIFICATIONS & ALERTS (Optional)
# ----------------------------------------------------------

# Slack Webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Discord Webhook for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=admin@example.com

# ----------------------------------------------------------
# COARE HPC INTEGRATION (Optional)
# ----------------------------------------------------------

# CKAN Data Catalog
CKAN_API_KEY=your-ckan-api-key
CKAN_BASE_URL=http://localhost:5000

# OpenStack Science Cloud
OS_AUTH_URL=https://coare-cloud.asti.dost.gov.ph:5000/v3
OS_USERNAME=your-openstack-username
OS_PASSWORD=your-openstack-password
OS_PROJECT_NAME=coare-project

# SLURM HPC Scheduler
SLURM_CONTROL_HOST=localhost
SLURM_PARTITION=debug

# ----------------------------------------------------------
# B5 FHE INTEGRATION (Requires License)
# ----------------------------------------------------------

# B5 FHE Engine endpoint
B5_FHE_HOST=http://localhost:8086
B5_FHE_API=http://localhost:8086/api

# ----------------------------------------------------------
# COARE SUITE SETTINGS
# ----------------------------------------------------------

# Server port
COARE_PORT=9000

# Log level: DEBUG, INFO, WARN, ERROR
COARE_LOG_LEVEL=INFO

# Auto-heal: enable/disable
AUTO_HEAL_ENABLED=true

# Auto-scale: enable/disable
AUTO_SCALE_ENABLED=true

# Alert interval (seconds)
ALERT_INTERVAL=60

# Archive interval (seconds)
ARCHIVE_INTERVAL=300

# ----------------------------------------------------------
# PHI CONSTANT (DO NOT CHANGE)
# ----------------------------------------------------------
PHI=1.6180339887498948482
